# Local POS server (local_pos_api) — copy to .env
api_port=8087
# only this computer; 0.0.0.0 to let other devices in the shop open the POS
HOST=127.0.0.1

# Local MongoDB on the POS computer
MONGO_DB_LOCAL=mongodb://127.0.0.1:27017/local_pos

# Cloud API (inventory_pos_api) and its API key (same as API_AUTH_KEY there)
CLOUD_API_URL=https://inventory-pos-api.vercel.app
CLOUD_API_KEY=

# Sync: push sales every N seconds, pull products / prices / staff every N minutes
SYNC_PUSH_SECONDS=15
SYNC_PULL_MINUTES=5
